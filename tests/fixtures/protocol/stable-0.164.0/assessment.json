  "authority": "tagged public protocol/source review and synthetic production-parser replay",
  "realAccountQualified": false,
  "l3Qualified": false,
  "stableQualified": false,
  "scope": "Review client-consumed protocol shapes and connection subscription contracts. This is not a complete upstream implementation audit or a live interoperability claim.",
  "decisions": [
    {
      "surface": "thread/list.excludedThreadIds",
      "change": "Optional exclusions, at most 100; unchanged behavior when omitted.",
      "decision": "Keep existing paginated inventory requests; do not exclude unseen threads."
    },
    {
      "surface": "thread/list.readStates, thread/read.readState, thread/readState/changed",
      "change": "Experimental revision-bound durable read receipts and notifications.",
      "decision": "Ignore additive metadata and unknown notifications. Preserve local unread/acknowledge authority; no readState/update writes or new sync capability."
    },
    {
      "surface": "imageGeneration",
      "change": "Generated item accepts result or fileId, plus optional inputImages.",
      "decision": "Retain the existing explicit generic item presentation for both image variants; preserve adjacent text and pagination without fetching image files."
    },
    {
      "surface": "TurnToolOutput.retain",
      "change": "Optional retention request on tool output.",
      "decision": "Client does not send tool-output payloads; no new history-writing behavior."
    },
    {
      "surface": "thread/resume, thread/unsubscribe",
      "change": "Public request/status shapes unchanged; source refactors unloading and restores saved model/permission settings.",
      "decision": "Keep explicit per-connection resume with excludeTurns, release cleanup after an attached error, response-before-request replay, and no implicit subscription from inventory/history reads."
    },
    {
      "surface": "thread/sample, thread/items/read, prediction-mode forks, feedback/save and other capabilities",
      "change": "New or extended capabilities outside this client feature scope.",
      "decision": "Do not opt into new methods; preserve the convergence freeze and fail-soft notification handling."
    }
  ],
