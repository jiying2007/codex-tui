    "historyReadsSubscribe": false,
    "turnStartSubscribes": false,
    "explicitAcquisition": {
      "method": "thread/resume",
      "params": {
        "threadId": "requested-thread",
        "excludeTurns": true
      }
    },
    "implicitAcquisition": [
      "thread/start",
      "thread/fork"
    ],
    "release": {
      "method": "thread/unsubscribe",
      "successStatuses": [
        "notLoaded",
        "notSubscribed",
        "unsubscribed"
      ]
    },
    "scopedDelivery": [
      "item/completed",
      "turn/started",
      "turn/completed",
      "thread/queue/changed",
      "interactive server requests"
    ],
    "warmResumeReplayOrder": "Resume response is enqueued before replaying pending server requests to the rejoining connection.",
    "resumeErrorAfterAttach": "A running-thread resume can add its connection before reading backwards cursors fails. A definitive application error therefore still requires release cleanup.",
    "authoritativeRemovalInvalidatesPendingRequests": "Archive/delete invalidate outstanding thread requests; they are not retained as owners that could reacquire the removed thread."
  },
