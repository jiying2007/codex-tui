+fn rev_parse_path(stdout: &str) -> Result<&str> {
+    // One requested path, one protocol LF. Embedded LF/CR and trailing spaces
+    // belong to the identity, not to presentation. Git for Windows emits LF too.
+    let path = stdout.strip_suffix('\n').context("Git path missing record terminator")?;
+    anyhow::ensure!(!path.is_empty() && !path.contains('\0'), "invalid Git path record");
+    Ok(path)
