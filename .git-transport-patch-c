+        let context = probe_context(ThreadId::new("test"), root.join("nested").to_str().unwrap().into()).await.unwrap();
+        assert_eq!(context.worktree.unwrap().canonical_path, root.canonicalize().unwrap().to_str().unwrap());
+        assert_eq!(context.repo.unwrap().git_common_dir, root.join(".git").canonicalize().unwrap().to_str().unwrap());
+        assert!(context.dirty);
+        assert_eq!(context.changes[0].path, "changed.txt");
+    }
+}
