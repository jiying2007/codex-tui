+#[tokio::test]
+async fn probe_readers_enforce_exact_boundary_and_stay_compact() {
+    for size in [0, 63, 64, 65, 65_536] {
+        let bytes = vec![b'x'; size];
+        let result = read_capped(bytes.as_slice(), 64, false).await;
+        if size <= 64 {
+            let (captured, truncated) = result.unwrap();
+            assert_eq!(captured, bytes);
+            assert!(!truncated);
+        } else {
+            assert!(result.unwrap_err().to_string().contains("budget exceeded"));
+        }
+    }
+    let reader = read_capped(tokio::io::empty(), MAX_GIT_PROBE_BYTES, false);
+    assert!(std::mem::size_of_val(&reader) <= 4096);
+    let args = ["status"];
+    let command = run_git_raw(".", &args);
+    assert!(std::mem::size_of_val(&command) <= 4096);
+}
