+#[test]
+fn status_limits_and_lossless_paths_fail_closed() {
+    let mut exact = b"? file\0".repeat(MAX_GIT_STATUS_ENTRIES);
+    assert_eq!(parse_porcelain_v2(&exact).unwrap().changes.len(), MAX_GIT_STATUS_ENTRIES);
+    exact.extend_from_slice(b"? extra\0");
+    assert!(parse_porcelain_v2(&exact).unwrap_err().to_string().contains("entry budget"));
+    assert!(parse_porcelain_v2(&vec![0; MAX_GIT_PROBE_BYTES + 1]).is_err());
+    for invalid in [b"? incomplete".as_slice(), b"? bad\xff\0", b"? ../escape\0",
+                    b"? \0", b"unknown entry\0", b"2 R. N... 100644 100644 100644 a b R100 name\0\0"] {
+        assert!(parse_porcelain_v2(invalid).is_err(), "{invalid:?}");
+    }
+    let parsed = parse_porcelain_v2(b"? line\nfile  \0").unwrap();
+    assert_eq!(parsed.changes[0].path, "line\nfile  ");
+}
