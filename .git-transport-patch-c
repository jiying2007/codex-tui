@@ -145,0 +146,82 @@ fn drawer_signals_forge_reader_ownership_and_board_churn() {
+
+#[test]
+fn git_identity_budget_and_connection_reader_ownership() {
+    let temporary = tempfile::tempdir().unwrap();
+    let retained = std::env::var_os("CODEX_TUI_PTY_EVIDENCE_DIR");
+    let root = retained
+        .as_deref()
+        .map(Path::new)
+        .unwrap_or_else(|| temporary.path());
+    std::fs::create_dir_all(root).unwrap();
+    let output = root.join("git-transports");
+    let log_path = root.join("git-transports.log");
+    let log = std::fs::File::create(&log_path).unwrap();
+    let mut child = Command::new("python3")
+        .arg("-O")
+        .arg(
+            Path::new(env!("CARGO_MANIFEST_DIR"))
+                .join("scripts/testing/git_transport_regression.py"),
+        )
+        .arg(env!("CARGO_BIN_EXE_codex-tui"))
+        .arg(&output)
+        .stdin(Stdio::null())
+        .stdout(log.try_clone().unwrap())
+        .stderr(log)
+        .spawn()
+        .unwrap();
+    let deadline = Instant::now() + Duration::from_secs(180);
+    let status = loop {
+        if let Some(status) = child.try_wait().unwrap() {
+            break status;
+        }
+        if Instant::now() >= deadline {
+            let _ = child.kill();
+            let _ = child.wait();
+            panic!(
+                "runtime harness timeout: {}",
+                std::fs::read_to_string(&log_path).unwrap_or_default()
+            );
+        }
+        std::thread::sleep(Duration::from_millis(20));
+    };
+    assert!(
+        status.success(),
+        "runtime regression: {}",
+        std::fs::read_to_string(&log_path).unwrap_or_default()
+    );
+    let receipt: serde_json::Value =
+        serde_json::from_slice(&std::fs::read(output.join("receipt.json")).unwrap()).unwrap();
+    assert_eq!(receipt["status"], "passed");
+    let cases = receipt["checks"].as_array().unwrap();
+    let expected = [
+        "editor-plain",
+        "editor-trailing",
+        "editor-newline",
+        "editor-cr",
+        "editor-nested",
+        "git-root-mismatch",
+        "git-identity-nonutf8",
+        "git-stderr-exact",
+        "git-stderr-over",
+        "git-stdout-exact",
+        "git-stdout-over",
+        "git-entries-exact",
+        "git-entries-over",
+        "git-status-no-nul",
+        "git-status-nonutf8",
+        "transport-startup-eof",
+        "transport-startup-held",
+        "transport-search-eof",
+        "transport-search-held",
+        "transport-search-replaced",
+        "git-fanout",
+    ];
+    assert_eq!(cases.len(), expected.len());
+    for (case, name) in cases.iter().zip(expected) {
+        assert_eq!(case["mode"], name);
+        assert_eq!(case["passed"], true);
+    }
+    assert_eq!(receipt["manualQualification"], false);
+    assert_eq!(receipt["realSshQualification"], false);
+    println!("{receipt}");
+}
