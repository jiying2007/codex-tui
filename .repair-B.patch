+fn propagate_git_context(state: &mut AppState, mut context: GitContext) {
+    // Separate cwd probes may observe the same worktree (e.g. nested sessions).
+    // Share equal immutable payloads, never timestamps or source authority.
+    if let Some(worktree) = context.worktree.as_ref()
+        && let Some(previous) = state.git_contexts.values().find(|previous| {
+            previous.error.is_none()
+                && previous.worktree.as_ref().is_some_and(|old| {
+                    old.repo == worktree.repo && old.canonical_path == worktree.canonical_path
+                })
+                && previous.changes == context.changes
+        })
+    {
+        context.changes = previous.changes.clone();
+    }
     let target_ids = state.thread_ids_for_cwd(&context.cwd);
