+#[test]
+fn planning_capture_shares_the_immutable_git_payload() {
+    let mut live = app(1);
+    let id = live.threads[0].id.clone();
+    let mut context = GitContext::pending(id.clone(), live.threads[0].metadata.cwd.clone());
+    context.changes = vec![crate::git::GitFileChange {
+        path: "tracked.rs".into(), original_path: None, index_status: None,
+        worktree_status: Some('M'), untracked: false, conflict: false,
+    }].into();
+    let payload = context.changes.clone();
+    live.git_contexts.insert(id.0.clone(), context);
+    let input = Input::capture(&live, 100);
+    assert!(std::sync::Arc::ptr_eq(&payload, &input.git[&id.0].changes));
+    let output = input.compute();
+    assert!(std::sync::Arc::ptr_eq(&payload, &output.source.git[&id.0].changes));
+}
