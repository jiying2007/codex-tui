+#[test]
+fn git_targets_capture_budgets_and_app_server_reader_lifetimes() {
+    let temporary = tempfile::tempdir().unwrap();
+    let retained = std::env::var_os("CODEX_TUI_PTY_EVIDENCE_DIR");
+    let root = retained.as_deref().map(Path::new).unwrap_or_else(|| temporary.path());
+    std::fs::create_dir_all(root).unwrap();
+    let output = root.join("git-resources");
+    let log_path = root.join("git-resources.log");
+    let log = std::fs::File::create(&log_path).unwrap();
+    let mut child = Command::new("python3")
+        .arg("-O")
+        .arg(Path::new(env!("CARGO_MANIFEST_DIR")).join("scripts/testing/git_resource_regression.py"))
+        .arg(env!("CARGO_BIN_EXE_codex-tui"))
+        .arg(&output)
+        .stdin(Stdio::null())
+        .stdout(log.try_clone().unwrap()).stderr(log).spawn().unwrap();
+    let deadline = Instant::now() + Duration::from_secs(150);
+    let status = loop {
+        if let Some(status) = child.try_wait().unwrap() { break status; }
+        if Instant::now() >= deadline {
+            let _ = child.kill(); let _ = child.wait();
+            panic!("Git resource harness timeout: {}", std::fs::read_to_string(&log_path).unwrap_or_default());
+        }
+        std::thread::sleep(Duration::from_millis(20));
+    };
+    assert!(status.success(), "Git resource regression: {}", std::fs::read_to_string(&log_path).unwrap_or_default());
+    let receipt: serde_json::Value = serde_json::from_slice(&std::fs::read(output.join("receipt.json")).unwrap()).unwrap();
+    assert_eq!(receipt["status"], "passed");
+    let cases = receipt["cases"].as_array().unwrap();
+    let expected = ["editor-normal", "editor-spaces", "editor-newline", "editor-linked",
+        "stderr-exact", "stderr-over", "stdout-exact", "stdout-over", "entries-exact",
+        "entries-over", "partial-record", "invalid-utf8", "init-eof", "init-held",
+        "search-eof", "search-held", "search-replaced"];
+    assert_eq!(cases.len(), expected.len());
+    for (case, name) in cases.iter().zip(expected) {
+        assert_eq!(case["name"], name); assert_eq!(case["passed"], true);
+    }
+    assert_eq!(receipt["manualQualification"], false);
+    assert_eq!(receipt["realAccountQualification"], false);
+}
