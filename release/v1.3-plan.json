  "evidenceGatedDecisions": {
    "gitlab-issue-board-projection": {
      "status": "evidence-gated",
      "rationale": [
        "normal GitLab refresh is intentionally capped at four glab API subprocesses",
        "adding board probing to normal refresh would cross the existing native-transport hard trigger",
        "current IssueBoardSummary exposes board identity only and cannot honestly project list/card membership"
      ],
      "retainedBehavior": [
        "GitLab issue boards remain observable through doctor capability probing",
        "normal Forge observation does not claim board membership projection"
      ],
      "reopenWhen": [
        "native GitLab transport hard trigger fires",
        "bounded board-membership projection becomes available without violating refresh budget",
        "real usage proves issue-board membership is required"
      ]
    },
    "github-safe-write-parity": {
      "status": "evidence-gated",
      "rationale": [
        "current mutation preflight and recovery semantics are GitLab-specific",
        "reusing GitLab numeric project-id and merge-request checks for GitHub would weaken fail-closed behavior",
        "internal primary Forge remains GitLab so unsafe symmetry has lower value than preserving mutation safety"
      ],
      "retainedBehavior": [
        "GitHub projection and review remain read-only",
        "mutation planning refuses non-GitLab provider identity"
      ],
      "reopenWhen": [
        "provider-specific GitHub preflight and verification contract is implemented",
        "real GitHub mutation demand is measured"
      ]
    }
  },
  "freezePolicy": {
    "newCoreFunctionality": "requires-new-development-plan",
    "allowedChangeClasses": [
      "defect-fix",
      "security",
      "compatibility",
      "qualification-evidence",
      "release-tooling",
      "documentation"
    ]
  }
